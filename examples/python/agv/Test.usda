                uint omni:rtx:pt:adaptiveSampling:fixedSppIterations = 2
                float omni:rtx:pt:fireflyFilter:maxPerEmissiveUnexposedIntensity
                float omni:rtx:pt:fireflyFilter:maxUnexposedIntensityPerSample
                float omni:rtx:pt:fireflyFilter:maxUnexposedIntensityPerSampleDiffuse
                uint omni:rtx:pt:maxSamplesPerLaunch = 2073600
