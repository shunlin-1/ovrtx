def Xform "World"
{
    def "AGV_Fix_01" (
        prepend payload = @./AGV_Fix.usda@
    )
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-260, 0, 80)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        over "AGV_Fix"
        {
            over "平台架子"
            {
                over "imagetostl_mesh0_002" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Looks/Carpaint_Metallic_04> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    float3 xformOp:rotateXYZ = (0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
                }
            }
        }
    }

    def Scope "Looks"
    {
        def Material "Carpaint_Metallic_04"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Carpaint_Metallic_04/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Carpaint_Metallic_04/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Carpaint_Metallic_04/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_2_1/Automotive/Imperfect/Carpaint/Carpaint_Metallic_04.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "Carpaint_Metallic_04"
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

    def "桂蘭樓_merge" (
        prepend payload = @./桂蘭樓_merge.usda@
    )
    {
    }
}

